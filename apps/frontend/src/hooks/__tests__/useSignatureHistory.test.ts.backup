import { renderHook, act } from "@testing-library/react";
import { toast } from "react-hot-toast";
import { apiService } from "@/services/api";
import { useSignatureHistory } from "../useSignatureHistory";

// Mock dependencies
const mockToast = toast as jest.Mocked<typeof toast>;
const mockApiService = apiService as jest.Mocked<typeof apiService>;

// Mock localStorage
const mockLocalStorage = {
  getItem: jest.fn(),
  setItem: jest.fn(),
  removeItem: jest.fn(),
  clear: jest.fn(),
};

Object.defineProperty(window, "localStorage", {
  value: mockLocalStorage,
  writable: true,
});

describe("useSignatureHistory", () => {
  beforeEach(() => {
    jest.clearAllMocks();
    mockLocalStorage.getItem.mockReturnValue(null);
  });

  describe("Initial State", () => {
    it("should initialize with empty history", () => {
      const { result } = renderHook(() => useSignatureHistory());

      expect(result.current.history).toEqual([]);
      expect(result.current.isLoading).toBe(false);
    });

    it("should load history from localStorage", () => {
      const savedHistory = [
        {
          id: "test-1",
          message: "Hello World",
          signature: "0xabcdef...",
          signer: "0x1234...5678",
          timestamp: Date.now(),
        },
      ];

      mockLocalStorage.getItem.mockReturnValue(JSON.stringify(savedHistory));

      const { result } = renderHook(() => useSignatureHistory());

      expect(result.current.history).toEqual(savedHistory);
      expect(mockLocalStorage.getItem).toHaveBeenCalledWith(
        "signature-history"
      );
    });

    it("should handle invalid localStorage data gracefully", () => {
      mockLocalStorage.getItem.mockReturnValue("invalid json");
      console.error = jest.fn(); // Mock console.error

      const { result } = renderHook(() => useSignatureHistory());

      expect(result.current.history).toEqual([]);
      expect(console.error).toHaveBeenCalledWith(
        "Failed to load signature history:",
        expect.any(SyntaxError)
      );
    });
  });

  describe("Adding Signatures", () => {
    it("should add signature to history", () => {
      const { result } = renderHook(() => useSignatureHistory());

      let signatureId: string;
      act(() => {
        signatureId = result.current.addSignature(
          "Hello World",
          "0xabcdef...",
          "0x1234...5678"
        );
      });

      expect(result.current.history).toHaveLength(1);
      expect(result.current.history[0]).toMatchObject({
        message: "Hello World",
        signature: "0xabcdef...",
        signer: "0x1234...5678",
      });
      expect(result.current.history[0].id).toBe(signatureId);
      expect(result.current.history[0].timestamp).toBeGreaterThan(0);
    });

    it("should add multiple signatures in correct order (newest first)", () => {
      const { result } = renderHook(() => useSignatureHistory());

      act(() => {
        result.current.addSignature("First", "0x111...", "0x1111...");
      });

      act(() => {
        result.current.addSignature("Second", "0x222...", "0x2222...");
      });

      expect(result.current.history).toHaveLength(2);
      expect(result.current.history[0].message).toBe("Second");
      expect(result.current.history[1].message).toBe("First");
    });

    it("should save to localStorage when adding signature", () => {
      const { result } = renderHook(() => useSignatureHistory());

      act(() => {
        result.current.addSignature("Test", "0xtest...", "0xtest...");
      });

      expect(mockLocalStorage.setItem).toHaveBeenCalledWith(
        "signature-history",
        expect.stringContaining('"message":"Test"')
      );
    });
  });

  describe("Verifying Signatures", () => {
    it("should verify signature successfully", async () => {
      const mockVerificationResponse = {
        isValid: true,
        signer: "0x1234...5678",
        originalMessage: "Hello World",
      };

      mockApiService.verifySignature.mockResolvedValue(
        mockVerificationResponse
      );

      const { result } = renderHook(() => useSignatureHistory());

      // Add a signature first
      act(() => {
        result.current.addSignature(
          "Hello World",
          "0xabcdef...",
          "0x1234...5678"
        );
      });

      const itemId = result.current.history[0].id;

      // Verify the signature
      await act(async () => {
        await result.current.verifySignature(itemId);
      });

      expect(mockApiService.verifySignature).toHaveBeenCalledWith({
        message: "Hello World",
        signature: "0xabcdef...",
      });

      expect(result.current.history[0].verification).toEqual(
        mockVerificationResponse
      );
      expect(result.current.history[0].isVerifying).toBe(false);
      expect(mockToast.success).toHaveBeenCalledWith(
        "✅ Signature verified successfully!",
        { duration: 4000 }
      );
    });

    it("should handle verification failure", async () => {
      const mockVerificationResponse = {
        isValid: false,
        signer: "0x1234...5678",
        originalMessage: "Hello World",
      };

      mockApiService.verifySignature.mockResolvedValue(
        mockVerificationResponse
      );

      const { result } = renderHook(() => useSignatureHistory());

      // Add a signature first
      act(() => {
        result.current.addSignature(
          "Hello World",
          "0xabcdef...",
          "0x1234...5678"
        );
      });

      const itemId = result.current.history[0].id;

      // Verify the signature
      await act(async () => {
        await result.current.verifySignature(itemId);
      });

      expect(result.current.history[0].verification).toEqual(
        mockVerificationResponse
      );
      expect(mockToast.error).toHaveBeenCalledWith(
        "❌ Signature verification failed",
        { duration: 5000 }
      );
    });

    it("should handle verification API error", async () => {
      const error = new Error("Network error");
      mockApiService.verifySignature.mockRejectedValue(error);

      const { result } = renderHook(() => useSignatureHistory());

      // Add a signature first
      act(() => {
        result.current.addSignature(
          "Hello World",
          "0xabcdef...",
          "0x1234...5678"
        );
      });

      const itemId = result.current.history[0].id;

      // Verify the signature
      await act(async () => {
        await result.current.verifySignature(itemId);
      });

      expect(result.current.history[0].verificationError).toBe("Network error");
      expect(result.current.history[0].isVerifying).toBe(false);
      expect(mockToast.error).toHaveBeenCalledWith(
        "❌ Verification error: Network error",
        { duration: 6000 }
      );
    });

    it("should set loading state during verification", async () => {
      let resolvePromise: (value: any) => void;
      const promise = new Promise((resolve) => {
        resolvePromise = resolve;
      });

      mockApiService.verifySignature.mockReturnValue(promise);

      const { result } = renderHook(() => useSignatureHistory());

      // Add a signature first
      act(() => {
        result.current.addSignature(
          "Hello World",
          "0xabcdef...",
          "0x1234...5678"
        );
      });

      const itemId = result.current.history[0].id;

      // Start verification
      const verificationPromise = act(async () => {
        await result.current.verifySignature(itemId);
      });

      // Check loading state
      expect(result.current.history[0].isVerifying).toBe(true);

      // Resolve the promise
      resolvePromise!({
        isValid: true,
        signer: "0x1234...5678",
        originalMessage: "Hello World",
      });

      await verificationPromise;

      expect(result.current.history[0].isVerifying).toBe(false);
    });

    it("should not verify non-existent signature", async () => {
      const { result } = renderHook(() => useSignatureHistory());

      await act(async () => {
        await result.current.verifySignature("non-existent-id");
      });

      expect(mockApiService.verifySignature).not.toHaveBeenCalled();
    });
  });

  describe("Removing Items", () => {
    it("should remove individual item", () => {
      const { result } = renderHook(() => useSignatureHistory());

      // Add two signatures
      act(() => {
        result.current.addSignature("First", "0x111...", "0x1111...");
        result.current.addSignature("Second", "0x222...", "0x2222...");
      });

      const itemToRemove = result.current.history[1].id; // "First" signature

      act(() => {
        result.current.removeItem(itemToRemove);
      });

      expect(result.current.history).toHaveLength(1);
      expect(result.current.history[0].message).toBe("Second");
      expect(mockToast.success).toHaveBeenCalledWith("🗑️ Item removed", {
        duration: 3000,
      });
    });

    it("should clear all history", () => {
      const { result } = renderHook(() => useSignatureHistory());

      // Add signatures
      act(() => {
        result.current.addSignature("First", "0x111...", "0x1111...");
        result.current.addSignature("Second", "0x222...", "0x2222...");
      });

      act(() => {
        result.current.clearHistory();
      });

      expect(result.current.history).toEqual([]);
      expect(mockToast.success).toHaveBeenCalledWith(
        "🗑️ History cleared successfully",
        { duration: 3000 }
      );
    });
  });

  describe("LocalStorage Persistence", () => {
    it("should save to localStorage when history changes", () => {
      const { result } = renderHook(() => useSignatureHistory());

      act(() => {
        result.current.addSignature("Test", "0xtest...", "0xtest...");
      });

      expect(mockLocalStorage.setItem).toHaveBeenCalledWith(
        "signature-history",
        expect.stringContaining("Test")
      );
    });

    it("should save to localStorage when clearing history", () => {
      const { result } = renderHook(() => useSignatureHistory());

      act(() => {
        result.current.clearHistory();
      });

      expect(mockLocalStorage.setItem).toHaveBeenCalledWith(
        "signature-history",
        "[]"
      );
    });
  });
});
