  "outputDirectory": "dist",
  "devCommand": "yarn dev",
  "installCommand": "cd ../.. && yarn install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
