{
  "name": "web3-signer-verifier",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "build": "yarn workspaces foreach -pt run build",
    "dev": "concurrently \"yarn workspace backend run dev\" \"yarn workspace frontend run dev\"",
    "test": "yarn workspaces foreach -pt run test",
    "test:watch": "yarn workspaces foreach -pt run test:watch",
    "test:coverage": "yarn workspaces foreach -pt run test -- --coverage",
    "lint": "yarn workspaces foreach -pt run lint",
    "lint:fix": "yarn workspaces foreach -pt run lint:fix",
    "type-check": "yarn workspaces foreach -pt run type-check",
    "clean": "yarn workspaces foreach -pt run clean"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.2.2"
  }
}
