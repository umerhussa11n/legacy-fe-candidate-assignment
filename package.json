{
  "name": "web3-signer-verifier",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "build": "yarn workspaces foreach --all --parallel --topological run build",
    "dev": "concurrently \"yarn workspace backend run dev\" \"yarn workspace frontend run dev\"",
    "test": "yarn workspaces foreach --all run test",
    "test:watch": "yarn workspaces foreach --all run test:watch",
    "test:coverage": "yarn workspaces foreach --all run test -- --coverage",
    "lint": "yarn workspaces foreach --all run lint",
    "lint:fix": "yarn workspaces foreach --all run lint:fix",
    "type-check": "yarn workspaces foreach --all run type-check",
    "clean": "yarn workspaces foreach --all run clean"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "mini-svg-data-uri": "^1.4.4"
  }
}
